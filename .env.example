# ─────────────────────────────────────────────────────────────────────────────
# AirGuard AI – Environment Variables
# Copy this file to .env and fill in your own values.
# Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── AQI Data Source ───────────────────────────────────────────────────────────
# Get a free key at https://aqicn.org/api/
AQICN_API_KEY=your_aqicn_api_key_here

# ── IBM watsonx.ai ────────────────────────────────────────────────────────────
# IBM Cloud API key — create at https://cloud.ibm.com/iam/apikeys
IBM_API_KEY=your_ibm_api_key_here
# watsonx.ai project ID — found in your IBM watsonx.ai project settings
IBM_PROJECT_ID=your_ibm_project_id_here
# watsonx.ai service URL (region-specific)
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
# Model to use for health advice generation
IBM_MODEL_ID=ibm/granite-13b-chat-v2

# ── IBM Langflow (optional, Phase 2+) ────────────────────────────────────────
# Langflow instance URL if you deploy IBM Langflow
LANGFLOW_BASE_URL=http://localhost:7860
# Langflow flow ID for the AQI multi-agent pipeline
LANGFLOW_FLOW_ID=your_langflow_flow_id_here
# Langflow API key (if your deployment requires auth)
LANGFLOW_API_KEY=your_langflow_api_key_here

# ── App Settings ──────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=true
SECRET_KEY=change_me_to_a_random_string
# How long to cache AQI responses in seconds (avoid hammering the API)
AQI_CACHE_TTL=300
